GITLAB_VERSION=19.2.2-ee.0
RUNNER_VERSION=latest

TZ=Asia/Taipei

GITLAB_HOST=localhost
GITLAB_HTTP_PORT=8929
GITLAB_SSH_PORT=2224

GITLAB_ROOT_EMAIL=admin@example.com
GITLAB_ROOT_PASSWORD=change-me-at-least-12-chars

# --- 備份 -------------------------------------------------------------
# 備份輸出位置。預設放專案底下的 ./backups（方便測試），
# 正式環境請改成專案目錄外、最好是另一顆實體碟，例如 /mnt/backup/gitlab
GITLAB_BACKUP_PATH=./backups
BACKUP_KEEP_DAYS=7

# 異地同步，二選一或都不填（backup.sh 會用）
#BACKUP_OFFSITE_RSYNC=user@nas:/volume1/backup/gitlab
#BACKUP_OFFSITE_RCLONE=b2:my-bucket/gitlab
